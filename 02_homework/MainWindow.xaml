<Window x:Class="_02_homework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_02_homework"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Аналізатор тексту"
                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                   Margin="0, 0, 0, 15"/>
        <TextBox x:Name="txtText" Grid.Row="1" TextWrapping="Wrap" 
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 FontSize="16" Padding="10"/>

        <Button x:Name="btnAnalyze" Grid.Row="2" Content="Проаналізувати"
                Width="180" Height="40" Margin="0,15" Click="btnAnalyze_Click"/>

        <TextBox x:Name="txtResult" Grid.Row="3" IsReadOnly="True"
                 TextWrapping="Wrap" FontSize="16" Padding="10"
                 VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
